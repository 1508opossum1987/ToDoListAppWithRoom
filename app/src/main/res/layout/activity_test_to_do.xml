<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TestToDoActivity">

    <TextView
        android:id="@+id/textView"
        android:text="TEST TODO LIST APP"
        android:textSize="30sp"
        android:textAlignment="center"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ListView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView"
        app:layout_constraintBottom_toTopOf="@+id/buttons" />

    <LinearLayout
        android:id="@+id/buttons"
        android:textSize="30sp"
        android:orientation="vertical"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:text="TEST SELECT ALL"
            android:textSize="30sp"
            android:onClick="onTestSelectAllClick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:text="TEST DELETE ALL"
            android:textSize="30sp"
            android:onClick="onTestDeleteAllClick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:text="TEST INSERT"
            android:textSize="30sp"
            android:onClick="onTestInsertClick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:text="GO BACK"
            android:textSize="30sp"
            android:onClick="onGoBackClick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>